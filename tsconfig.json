{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun", "node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@yodea/contracts/*": ["packages/contracts/*"],
      "@yodea/client-core/*": ["packages/client-core/*"],
      "@yodea/client-core": ["packages/client-core/index.ts"],
      "@yodea/tui/*": ["apps/tui/*"],
      "@yodea/desktop/*": ["apps/desktop/src/*"],
      "@yodea/*": ["apps/cli/*"]
    }
  },
  "include": ["apps/cli", "apps/tui", "packages", "test", "migrations", "vitest.config.ts"],
  "exclude": [
    "apps/desktop/src/main/index.ts",
    "apps/desktop/src/preload",
    "apps/desktop/src/renderer",
    "test/desktop/rename-dialog.test.tsx",
    "test/desktop/change-directory-dialog.test.tsx",
    "test/desktop/edit-metadata-dialog.test.tsx",
    "test/desktop/delete-project-dialog.test.tsx",
    "test/desktop/command-palette-restore.test.tsx"
  ]
}
