{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@expand/tui/*": ["apps/tui/*"],
      "@expand/desktop/*": ["apps/desktop/src/*"],
      "@expand/server/*": ["apps/server/*"],
      "@expand/electron-ipc/*": ["packages/electron-ipc/*"],
      "@expand/ink-input/*": ["packages/ink-input/*"],
      "@expand/*": ["apps/cli/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "diagnosticsName": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectSuggestionsInTscExitCode": true,
        "diagnosticSeverity": {
          "asyncFunction": "error",
          "newPromise": "error",
          "nodeBuiltinImport": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "preferSchemaOverJson": "error",
          "floatingEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "runEffectInsideEffect": "error",
          "tryCatchInEffectGen": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "effectFnOpportunity": "message"
        }
      }
    ]
  },
  "include": ["apps/cli", "apps/server", "apps/tui", "packages", "migrations", "vitest.config.ts", "test/architecture", "bench", "examples", "scripts"],
  "exclude": [
    "apps/desktop"
  ]
}
