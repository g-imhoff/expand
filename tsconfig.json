{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun", "node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@expand/tui/*": ["apps/tui/*"],
      "@expand/desktop/*": ["apps/desktop/src/*"],
      "@expand/server/*": ["apps/server/*"],
      "@expand/electron-ipc/*": ["packages/electron-ipc/*"],
      "@expand/ink-input/*": ["packages/ink-input/*"],
      "@expand/*": ["apps/cli/*"]
    }
  },
  "include": ["apps/cli", "apps/server", "apps/tui", "packages", "migrations", "vitest.config.ts", "test/architecture", "bench", "examples", "scripts"],
  "exclude": [
    "apps/desktop"
  ]
}
