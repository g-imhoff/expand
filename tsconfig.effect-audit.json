{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "examples",
    "bench",
    "migrations",
    "test",
    "eslint-rules",
    "docs/architecture",
    "*.ts",
    "*.tsx",
    "*.mts",
    "*.cts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/out/**", "**/build/**", "**/coverage/**", "**/test-results/**", "**/playwright-report/**"]
}
