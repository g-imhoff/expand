specification {
  element actor {
    style {
      shape: person
    }
  }
  element system
  element externalSystem {
    style {
      color: muted
    }
  }
  element container
  element component
}

model {
  user = actor 'User' {
    description 'Uses the desktop UI or invokes the CLI.'
  }

  acpServer = externalSystem 'Coding agent (ACP subprocess)' {
    description 'Third-party agent spawned by yodea. Communicates via ACP (JSON-RPC over stdio). The yodea CLI is exposed as a tool.'
  }

  yodea = system 'Yodea' {
    description 'AI-assisted development workflow tool.'

    desktop = container 'Desktop app' {
      description 'Electron shell hosting the React UI. Connects to the backend over WebSocket.'
      technology 'Electron · Vite · React'

      ui = component 'UI' {
        description 'Views, routing, presentation.'
        technology 'React'
      }

      state = component 'State store' {
        description 'Read-model of server events.'
        technology 'Zustand'
      }

      rpcClient = component 'RPC client' {
        description 'Queries, commands, event subscription.'
        technology 'Effect RPC'
      }

      discovery = component 'Backend discovery' {
        description 'Finds or spawns the backend via endpoint file.'
      }

      ui    -> state     'reads + dispatches'
      state -> rpcClient 'commands + events'
      rpcClient -> discovery 'resolves backend'
    }

    cli = container 'yodea CLI (client)' {
      description 'Thin RPC client. Same binary, but never instantiates an AppLayer — always talks to a running backend. See BOUNDARIES.md I-1 for the isolation invariant.'
      technology 'TypeScript · Effect · @effect/cli'

      cliEntry = component 'CLI entrypoint' {
        description 'Parses args, forwards to backend. Stable verbs + --json for agent use.'
        technology '@effect/cli'
      }

      cliRpcClient = component 'RPC client' {
        description 'Same WebSocket transport as desktop.'
        technology 'Effect RPC'
      }

      cliDiscovery = component 'Backend discovery' {
        description 'Finds or spawns backend under exclusive lock.'
      }

      cliEntry -> cliRpcClient 'dispatches'
      cliRpcClient -> cliDiscovery 'resolves backend'
    }

    backend = container 'yodea Backend service' {
      description 'Single long-running process hosting the AppLayer. All state lives here. See BOUNDARIES.md I-2 for single-instance rule, I-4 for lifetime.'
      technology 'TypeScript · Effect · WebSocket'

      rpcServer = component 'RPC server' {
        description 'Queries/commands + global event stream.'
        technology 'Effect RPC · WebSocket'
      }

      useCases = component 'Use-cases + Domain' {
        description 'Hexagonal core. Publishes DomainEvents on state changes.'
      }

      eventBus = component 'Domain Event Bus' {
        description 'Global broadcast of all domain events. Frontends subscribe once.'
        technology 'Effect.PubSub'
      }

      services = component 'Services' {
        description 'Project-scoped services: Git, File Watcher, Terminal, Diff Parser, Syntax Highlighter, ACP Client. See Backend Services view for details.'

        acpClient = component 'ACP Client' {
          description 'Brokers the coding agent subprocess.'
          technology 'Effect Layer · JSON-RPC stdio'
        }

        projectQueue = component 'Project TxQueue' {
          description 'Per-project sequential queue. Serializes filesystem access and tool call barriers.'
          technology 'Effect.TxQueue'
        }

        gitService = component 'Git Service' {
          description 'All git operations. Async I/O — yields the fiber while the subprocess runs.'
          technology 'child_process · Effect'
        }

        fileWatcher = component 'File Watcher' {
          description 'One per project root. Native debounce in C++ layer. Ignores node_modules, .git, dist.'
          technology '@parcel/watcher'
        }

        highlighter = component 'Syntax Highlighter' {
          description 'Singleton. CPU-intensive — runs in a worker thread. Returns pre-rendered HTML.'
          technology 'Shiki · Worker thread'
        }

        diffParser = component 'Diff Parser' {
          description 'Parses git diff output into structured hunks. CPU-intensive — shares the worker thread with the highlighter.'
          technology 'parse-git-diff · Worker thread'
        }

        terminal = component 'Terminal Service' {
          description 'One PTY per session. Bridges stdin/stdout over WebSocket via Effect Stream. Backpressure on slow clients.'
          technology 'node-pty'
        }

        acpClient -> projectQueue  'serializes tool calls'
        gitService -> projectQueue 'serializes git calls'
        diffParser -> highlighter  'highlights hunks'
      }

      storage = component 'Session Storage' {
        description 'Event log + snapshots. Persists events, serves history queries.'
        technology 'SQLite (WAL)'
      }

      configSecrets = component 'Config & Secrets' {
        description 'Typed config; secrets via OS keychain.'
        technology 'Effect Config'
      }

      endpointFile = component 'Endpoint file' {
        description 'server.json — URL, token, PID. Written on startup, removed on shutdown.'
      }

      rpcServer -> useCases            'queries / commands'
      rpcServer -> eventBus            'streams events'
      rpcServer -> endpointFile        'writes on startup'

      useCases -> services.acpClient   'sends prompts'
      useCases -> services.gitService  'git operations'
      useCases -> services.diffParser  'parses diffs'
      useCases -> services.highlighter 'highlights code'
      useCases -> services.terminal    'terminal I/O'
      useCases -> storage              'reads sessions'
      useCases -> configSecrets        'reads config'
      useCases -> eventBus             'publishes events'

      services.acpClient   -> eventBus  'agent events'
      services.fileWatcher -> eventBus  'file change events'
      eventBus             -> storage   'persists event log'
    }

    desktop.rpcClient -> backend.rpcServer 'WebSocket'
    cli.cliRpcClient  -> backend.rpcServer 'WebSocket'

    desktop.discovery -> backend.endpointFile 'discovers backend'
    cli.cliDiscovery  -> backend.endpointFile 'discovers backend'
  }

  user -> yodea.desktop        'uses UI'
  user -> yodea.cli.cliEntry   'invokes commands'

  yodea.backend.acpClient -> acpServer          'ACP'
  acpServer               -> yodea.cli.cliEntry 'invokes yodea CLI'
}

views {

  view overall of yodea {
    title 'Overall Architecture'
    include *
  }

  view backend of yodea.backend {
    title 'Backend Architecture'
    include *
  }

  view desktop of yodea.desktop {
    title 'Desktop Architecture'
    include *
  }

  view cli of yodea.cli {
    title 'CLI Architecture'
    include *
  }

  view services of yodea.backend.services {
    title 'Backend Services'
    include *
  }

  view context {
    title 'System Context'
    include user, yodea, acpServer
  }
}
