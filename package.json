{
  "name": "expand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": ["packages/contracts", "packages/client-ts"],
  "module": "apps/cli/cli/main.ts",
  "bin": {
    "expand": "apps/cli/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:fold-version": "bun run scripts/fold-version.ts",
    "agents:sync": "bun run scripts/sync-agents.ts",
    "agents:check": "bun run scripts/sync-agents.ts --check",
    "bench:events": "bun bench/main.ts",
    "bench:selfcheck": "bun bench/selfcheck.ts",
    "typecheck:all": "bun run typecheck && bun run typecheck:desktop",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:watch": "bun --bun vitest",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip-bun",
    "build": "bun run build:cli && bun run build:server",
    "build:cli": "bun build apps/cli/cli/main.ts --compile --define __EXPAND_CHANNEL__='\"release\"' --no-compile-autoload-dotenv --outfile dist/expand",
    "build:server": "bun build apps/server/main.ts --compile --define __EXPAND_CHANNEL__='\"release\"' --no-compile-autoload-dotenv --outfile dist/expand-server",
    "cert:cli:build": "bun run build && bash scripts/binary-smoke.sh",
    "dev:cli": "bun apps/cli/cli/main.ts",
    "dev:server": "bun apps/server/main.ts",
    "dev:tui": "bun apps/tui/main.tsx",
    "dev:desktop": "cd apps/desktop && electron-vite dev -w",
    "build:desktop": "cd apps/desktop && electron-vite build",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "e2e:desktop": "bun run build:desktop && playwright test -c apps/desktop/e2e/playwright.config.ts",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.74",
    "@effect/platform-node": "4.0.0-beta.74",
    "@effect/sql-sqlite-bun": "4.0.0-beta.74",
    "@effect/sql-sqlite-node": "4.0.0-beta.74",
    "@expand/client-ts": "0.0.0",
    "@expand/contracts": "0.0.0",
    "@tanstack/react-router": "^1.95.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.0.0-beta.74",
    "ink": "7",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "19",
    "react-dom": "19",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-istanbul": "4.1.7",
    "@vitest/coverage-v8": "4.1.7",
    "dependency-cruiser": "17.4.2",
    "electron": "42",
    "electron-vite": "5",
    "esbuild": "^0.27.4",
    "eslint": "^10.5.0",
    "fast-check": "4.8.0",
    "happy-dom": "^20.9.0",
    "ink-testing-library": "4",
    "knip": "^6.17.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "7.3.6",
    "vitest": "4.1.7"
  }
}
