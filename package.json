{
  "name": "yodea",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "apps/cli/cli/main.ts",
  "bin": {
    "yodea": "apps/cli/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "build": "bun build apps/cli/cli/main.ts --compile --outfile dist/yodea",
    "dev:cli": "bun apps/cli/cli/main.ts",
    "dev:server": "bun apps/cli/cli/main.ts server",
    "dev:tui": "bun apps/tui/main.tsx",
    "dev:desktop": "cd apps/desktop && electron-vite dev",
    "build:desktop": "cd apps/desktop && electron-vite build",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "e2e:desktop": "playwright test -c apps/desktop/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.74",
    "@effect/platform-node": "4.0.0-beta.74",
    "@effect/sql-sqlite-bun": "4.0.0-beta.74",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.95.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.0.0-beta.74",
    "ink": "7",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "dependency-cruiser": "17.4.2",
    "electron": "42",
    "electron-playwright-helpers": "^1.7.1",
    "electron-vite": "5",
    "ink-testing-library": "4",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
