{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@expand/desktop/*": ["../../apps/desktop/src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../apps/desktop/src/renderer/features/chat",
    "../../apps/desktop/src/renderer/components/ui"
  ]
}
